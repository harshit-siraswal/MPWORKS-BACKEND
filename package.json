{
  "name": "mplad-intelligence-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "test": "node tests/smoke-test.mjs",
    "fetch:mplads": "node scripts/fetch-esakshi.mjs",
    "fetch:esakshi": "node scripts/fetch-esakshi.mjs",
    "ingest": "node scripts/run-ingest.mjs",
    "publish:esakshi": "node scripts/publish-esakshi-reports.mjs",
    "publish:esakshi:stream": "node scripts/publish-esakshi-stream.mjs",
    "fetch:esakshi:without-attachments": "node scripts/fetch-esakshi.mjs --without-attachments",
    "fetch:mplads:dry": "node scripts/fetch-esakshi.mjs --dry-run",
