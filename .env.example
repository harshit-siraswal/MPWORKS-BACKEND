MPLADS_SOURCE_URL=https://mplads.mospi.gov.in/digigov/dashboard.html
MPLADS_API_ORIGIN=https://mplads.mospi.gov.in
MPLADS_MAX_STATES=0
MPLADS_MAX_WORKS=0

# Never commit real secrets. The LangGraph worker reads these at runtime.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_CLOUD_PROJECT=200141425784

# Server-side Supabase only; do not expose the service role key in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_ORG_ID=

# S3-compatible Cloudflare R2 credentials; account ID and endpoint are not enough to write.
R2_ACCOUNT_ID=
R2_BUCKET=mpworks
R2_ENDPOINT=https://3df99a00c707520696105ece185c3de8.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
